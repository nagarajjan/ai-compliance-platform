# ──────────────────────────────────────────────
# AI Compliance Platform — Backend Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Ollama (local LLM & embeddings)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text:latest
LLM_MODEL=llama3.2

# Storage paths
# On Windows, use absolute paths with forward slashes:
# UPLOAD_DIR=C:/Users/YourName/path/to/project/vectorstore
# CHROMA_PERSIST_DIR=C:/Users/YourName/path/to/project/vectorstore/chroma_db
UPLOAD_DIR=../vectorstore
CHROMA_PERSIST_DIR=../vectorstore/chroma_db

# ── Cloud LLM Provider API Keys (optional) ──
# Configure these via the UI Settings panel, or set them here.

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GEMINI_API_KEY=AIza...

# DeepSeek
# DEEPSEEK_API_KEY=sk-...

# Perplexity
# PERPLEXITY_API_KEY=pplx-...

# Custom OpenAI-compatible endpoint
# CUSTOM_BASE_URL=https://your-endpoint/v1
# CUSTOM_API_KEY=your-key
